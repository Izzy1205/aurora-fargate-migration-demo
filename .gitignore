# Terraform
.terraform/
# Per-env data dirs from scripts/bootstrap.sh (TF_DATA_DIR)
.terraform-*/
*.tfstate
*.tfstate.*
*.tfplan
tfplan
plan.txt
crash.log
crash.*.log
*.tfvars
*.tfvars.json
!*.tfvars.example
backend.hcl
override.tf
override.tf.json
*_override.tf
*_override.tf.json
.terraformrc
terraform.rc

# Terragrunt
.terragrunt-cache/
.terragrunt-stack/
# Lock files from a local `terraform init -backend=false` in a layer or
# module. The committed ones live in each unit folder under environments/.
terraform/layers/*/.terraform.lock.hcl
terraform/modules/*/.terraform.lock.hcl

# Run logs from scripts/bootstrap.sh
logs/

# Secrets and local env
.env
.env.*
*.pem
*.key
*.p12
*.pfx
credentials
.aws/

# Python
__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/
*.egg-info/
.coverage
htmlcov/

# Editors and OS
.idea/
.vscode/
.DS_Store
*~
